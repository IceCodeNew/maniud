#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)) || [[ ! "$1" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
	printf 'usage: %s VERSION\n' "$0" >&2
	exit 2
fi

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
expected="v$1"
module_prefix='github.com/IceCodeNew/maniud/'
failure=false

while IFS= read -r module; do
	mismatches="$({
		cd "$repository_root/$module"
		GOWORK=off go mod edit -json
	} | jq -r \
		--arg prefix "$module_prefix" \
		--arg expected "$expected" '
			(.Require // [])[] |
			select(.Path | startswith($prefix)) |
			select(.Version != $expected) |
			"\(.Path) requires \(.Version), want \($expected)"
		')"
	if [[ -n "$mismatches" ]]; then
		printf '%s/go.mod: %s\n' "$module" "$mismatches" >&2
		failure=true
	fi
done < <("$repository_root/scripts/list-go-modules")

if [[ "$failure" == true ]]; then
	exit 1
fi
