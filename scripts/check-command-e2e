#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${MANIUD_GATE_MANIFEST:-}" ]]; then
	if ! command_e2e="$(awk -F $'\t' '
    $1 == "command-e2e" {
      count++
      value = $2
      if (NF != 2) invalid = 1
    }
    END {
      if (count != 1 || invalid || (value != "true" && value != "false")) exit 1
      print value
    }
  ' "$MANIUD_GATE_MANIFEST")"; then
		printf '%s\n' 'invalid gate manifest: expected one command-e2e row' >&2
		exit 1
	fi
	if [[ "$command_e2e" == false ]]; then
		printf '%s\n' 'command E2E not selected'
		exit 0
	fi
fi

if (($# > 1)); then
	printf 'usage: %s [maniud-binary]\n' "$0" >&2
	exit 2
fi

repo_root="$(cd "$(dirname "$0")/.." && pwd -P)"
temporary_dir="$(cd "$(mktemp -d)" && pwd -P)"
engine_pid=
cleanup() {
	if [[ -n "$engine_pid" ]]; then
		kill "$engine_pid" >/dev/null 2>&1 || true
		wait "$engine_pid" 2>/dev/null || true
	fi
	rm -rf "$temporary_dir"
}
trap cleanup EXIT

binary="${1:-$temporary_dir/maniud}"
if (($# == 0)); then
	"$repo_root/scripts/build-maniud" "$binary"
elif [[ ! -x "$binary" ]]; then
	printf 'maniud binary is not executable: %s\n' "$binary" >&2
	exit 2
fi

version="$("$binary" --version)"
if [[ ! "$version" =~ ^maniud\ ((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)|[0-9]{8}(-dirty)?-g[0-9a-f]{12})$ ]]; then
	printf 'unexpected maniud version: %s\n' "$version" >&2
	exit 1
fi

quickstart_repository="$temporary_dir/quickstart"
quickstart_state="$temporary_dir/quickstart-state"
quickstart_docker_config="$temporary_dir/quickstart-docker-config"
quickstart_socket="$temporary_dir/qs.sock"
quickstart_ready="$temporary_dir/qs.ready"
quickstart_engine_log="$temporary_dir/qs-engine.log"
mkdir -p "$quickstart_repository/services" "$quickstart_docker_config"
mkdir -m 0700 "$quickstart_state"

case "$(uname -m)" in
x86_64 | amd64)
	quickstart_architecture=amd64
	quickstart_variant=
	quickstart_manifest=sha256:40bc662f062f4b8bd2c565f33afd213abcadb0afd138dfc45c5c1c19edd8d319
	quickstart_config=sha256:3f62c8d50142dbc9d3a53643b53faae8ea5bef43c2e1f7a669f76652cca2e87c
	;;
aarch64 | arm64)
	quickstart_architecture=arm64
	quickstart_variant=v8
	quickstart_manifest=sha256:9f5b47e91c32055c5ccc860c1de27a21117936e84c44543a750482d51d541134
	quickstart_config=sha256:15018ca4eb9f691fe2784cf3171220a1a107c7dca6cbec04bf1add309d3853f6
	;;
*)
	printf 'unsupported quickstart test architecture: %s\n' "$(uname -m)" >&2
	exit 1
	;;
esac

quickstart_digest=sha256:990002083442f6a93cd3249da32ecb7c3f6be778a1bec3a73a9c17fbc40edc15
quickstart_image="registry.access.redhat.com/ubi9/ubi-micro@$quickstart_digest"
python3 - \
	"$quickstart_socket" \
	"$quickstart_ready" \
	"$quickstart_architecture" \
	"$quickstart_variant" \
	"$quickstart_manifest" \
	"$quickstart_config" \
	"$quickstart_image" >"$quickstart_engine_log" 2>&1 <<'PY' &
import http.server
import json
import os
import socketserver
import sys
import urllib.parse

socket_path, ready_path, architecture, variant, manifest, config, image = sys.argv[1:]


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, format, *arguments):
        print(format % arguments, file=sys.stderr)

    def respond(self, status, body=b"", content_type=None, headers=None):
        self.send_response(status)
        if content_type is not None:
            self.send_header("Content-Type", content_type)
        if headers is not None:
            for name, value in headers.items():
                self.send_header(name, value)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_HEAD(self):
        if self.path == "/_ping":
            self.respond(200, headers={"Api-Version": "1.55"})
            return
        self.respond(404, b'{"message":"missing"}', "application/json")

    def do_GET(self):
        request = urllib.parse.urlsplit(self.path)
        path = request.path
        if path == "/_ping":
            self.respond(200, b"OK", "text/plain", {"Api-Version": "1.55"})
            return
        if path == "/v1.55/version":
            self.json_response({
                "Version": "29.7.2",
                "ApiVersion": "1.55",
                "MinAPIVersion": "1.40",
                "Os": "linux",
                "Arch": architecture,
            })
            return
        if path == "/v1.55/info":
            self.json_response({
                "ID": "quickstart-engine",
                "Driver": "overlay2",
                "OSType": "linux",
                "Architecture": architecture,
                "ServerVersion": "29.7.2",
                "SecurityOptions": [],
            })
            return
        expected_image_path = "/v1.55/images/" + image + "/json"
        platform_values = urllib.parse.parse_qs(request.query).get("platform", [])
        expected_platform = {"architecture": architecture, "os": "linux"}
        if variant:
            expected_platform["variant"] = variant
        try:
            platform_matches = (
                len(platform_values) == 1
                and json.loads(platform_values[0]) == expected_platform
            )
        except json.JSONDecodeError:
            platform_matches = False
        if path == expected_image_path and platform_matches:
            self.json_response({
                "Id": config,
                "RepoDigests": [image],
                "Config": {},
                "Architecture": architecture,
                "Variant": variant,
                "Os": "linux",
                "Size": 0,
                "Descriptor": {
                    "mediaType": "application/vnd.oci.image.manifest.v1+json",
                    "digest": manifest,
                    "size": 1,
                },
            })
            return
        if path == "/v1.55/containers/maniud-hello/json":
            self.respond(404, b'{"message":"No such container"}', "application/json")
            return
        self.respond(404, b'{"message":"missing"}', "application/json")

    def json_response(self, document):
        self.respond(
            200,
            json.dumps(document, separators=(",", ":")).encode(),
            "application/json",
        )


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


try:
    os.unlink(socket_path)
except FileNotFoundError:
    pass

with Server(socket_path, Handler) as server:
    with open(ready_path, "w", encoding="utf-8") as stream:
        stream.write("ready\n")
    server.serve_forever()
PY
engine_pid=$!

for _ in {1..100}; do
	if [[ -f "$quickstart_ready" ]]; then
		break
	fi
	sleep 0.05
done
if [[ ! -f "$quickstart_ready" ]]; then
	cat "$quickstart_engine_log" >&2
	printf '%s\n' 'quickstart Docker fixture did not start' >&2
	exit 1
fi

git -C "$quickstart_repository" init --quiet --initial-branch=master
quickstart_gen_output="$temporary_dir/quickstart-gen.json"
quickstart_compose="$quickstart_repository/services/maniud-hello.yaml"
if ! env \
	DOCKER_CONFIG="$quickstart_docker_config" \
	DOCKER_HOST="unix://$quickstart_socket" \
	HOME="$temporary_dir/home" \
	XDG_STATE_HOME="$quickstart_state" \
	"$binary" gen \
	--name maniud-hello \
	--output "$quickstart_compose" \
	--json \
	-- docker run --name maniud-hello --restart unless-stopped \
	"$quickstart_image" /usr/bin/sleep infinity >"$quickstart_gen_output"; then
	cat "$quickstart_gen_output" >&2
	cat "$quickstart_engine_log" >&2
	exit 1
fi
python3 - "$quickstart_gen_output" "$quickstart_compose" "$quickstart_image" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    result = json.load(stream)
if result != {"path": sys.argv[2], "status": "generated"}:
    raise SystemExit(f"unexpected quickstart gen result: {result!r}")
with open(sys.argv[2], encoding="utf-8") as stream:
    compose = stream.read()
required = (
    f"        image: {sys.argv[3]}\n",
    "        container_name: maniud-hello\n",
    "            - /usr/bin/sleep\n",
    "            - infinity\n",
)
if any(value not in compose for value in required):
    raise SystemExit("quickstart Compose content does not match the documented input")
PY

git -C "$quickstart_repository" add -- services/maniud-hello.yaml
git -C "$quickstart_repository" \
	-c user.name='maniud e2e' \
	-c user.email='maniud-e2e@example.invalid' \
	-c commit.gpgsign=false \
	commit --quiet -m 'add quickstart service'

quickstart_apply_output="$temporary_dir/quickstart-apply.txt"
if ! env \
	DOCKER_CONFIG="$quickstart_docker_config" \
	DOCKER_HOST="unix://$quickstart_socket" \
	HOME="$temporary_dir/home" \
	XDG_STATE_HOME="$quickstart_state" \
	"$binary" apply --dry-run "$quickstart_compose" >"$quickstart_apply_output"; then
	cat "$quickstart_apply_output" >&2
	cat "$quickstart_engine_log" >&2
	exit 1
fi
python3 - "$quickstart_apply_output" "$quickstart_image" "$quickstart_architecture" "$quickstart_variant" <<'PY'
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    output = stream.read()
platform = "linux/" + sys.argv[3]
if sys.argv[4]:
    platform += "/" + sys.argv[4]
required = (
    "Dry run passed for maniud-hello/maniud-hello.\n",
    "Action: create a new workload (bootstrap).\n",
    f"Runtime: docker on {platform}.\n",
    f"Image: {sys.argv[2]}.\n",
    "Ready to apply. No changes were made.\n",
)
if output != "".join(required):
    raise SystemExit(f"unexpected quickstart dry-run output: {output!r}")
PY

archive="$temporary_dir/hello.tar"
python3 - "$archive" <<'PY'
import hashlib
import io
import json
import sys
import tarfile

archive_path = sys.argv[1]
layer = b"layer"
config = json.dumps(
    {
        "architecture": "amd64",
        "os": "linux",
        "rootfs": {
            "type": "layers",
            "diff_ids": [f"sha256:{hashlib.sha256(layer).hexdigest()}"],
        },
        "config": {"Entrypoint": ["/init"], "Cmd": ["serve"]},
    },
    separators=(",", ":"),
    sort_keys=True,
).encode()
manifest = json.dumps(
    [
        {
            "Config": "config.json",
            "RepoTags": ["example.invalid/hello:1"],
            "Layers": ["layer.tar"],
        }
    ],
    separators=(",", ":"),
    sort_keys=True,
).encode()

with tarfile.open(archive_path, "w", format=tarfile.USTAR_FORMAT) as archive:
    for name, content in (
        ("manifest.json", manifest),
        ("config.json", config),
        ("layer.tar", layer),
    ):
        member = tarfile.TarInfo(name)
        member.mode = 0o600
        member.mtime = 0
        member.size = len(content)
        archive.addfile(member, io.BytesIO(content))
PY
chmod 0600 "$archive"

source_repository="$temporary_dir/source"
mkdir -p "$source_repository/services"
git -C "$source_repository" init --quiet --initial-branch=main

gen_output="$temporary_dir/gen.json"
if ! (
	cd "$source_repository"
	"$binary" gen \
		--name hello \
		--output services/hello.yaml \
		--json \
		"docker-archive:$archive:example.invalid/hello:1" >"$gen_output"
); then
	cat "$gen_output" >&2
	exit 1
fi
python3 - "$gen_output" "$source_repository/services/hello.yaml" <<'PY'
import json
import os
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    result = json.load(stream)
if result.get("path") != "services/hello.yaml" or result.get("status") != "generated":
    raise SystemExit(f"unexpected gen result: {result!r}")
if not result.get("import_command", "").startswith("docker image load --input "):
    raise SystemExit(f"missing archive import guidance: {result!r}")
if not os.path.isfile(sys.argv[2]):
    raise SystemExit("gen did not create the Compose file")
PY

git -C "$source_repository" add -- services/hello.yaml
git -C "$source_repository" \
	-c user.name='maniud e2e' \
	-c user.email='maniud-e2e@example.invalid' \
	-c commit.gpgsign=false \
	commit --quiet -m 'add generated service'

state_home="$temporary_dir/state"
mkdir -m 0700 "$state_home"
apply_output="$temporary_dir/apply.json"
set +e
(
	cd "$source_repository"
	env \
		DOCKER_HOST="unix://$temporary_dir/missing-docker.sock" \
		HOME="$temporary_dir/home" \
		XDG_STATE_HOME="$state_home" \
		"$binary" apply --dry-run services/hello.yaml >"$apply_output"
)
apply_status=$?
set -e
if ((apply_status != 1)); then
	printf 'apply smoke returned %d, want 1\n' "$apply_status" >&2
	exit 1
fi
python3 - "$apply_output" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    result = json.load(stream)
expected = {
    "code": "apply_failed",
    "message": "apply validation failed",
    "retryable": True,
}
if result != expected:
    raise SystemExit(f"unexpected apply failure: {result!r}")
PY

remote_repository="$temporary_dir/origin.git"
gitops_repository="$temporary_dir/gitops"
git init --bare --quiet "$remote_repository"
git init --quiet --initial-branch=master "$gitops_repository"
mkdir "$gitops_repository/services"
: >"$gitops_repository/services/.keep"
git -C "$gitops_repository" add -- services/.keep
git -C "$gitops_repository" \
	-c user.name='maniud e2e' \
	-c user.email='maniud-e2e@example.invalid' \
	-c commit.gpgsign=false \
	commit --quiet -m 'initialize desired state'
git -C "$gitops_repository" remote add origin "$remote_repository"
git -C "$gitops_repository" push --quiet --set-upstream origin master

shared_environment=(HOME="$temporary_dir/home" XDG_STATE_HOME="$state_home")
env "${shared_environment[@]}" "$binary" gitops init "$gitops_repository"

daemon_output="$temporary_dir/daemon.log"
python3 - "$binary" "$temporary_dir/home" "$state_home" "$daemon_output" <<'PY'
import os
import subprocess
import sys
import time

environment = os.environ.copy()
environment["HOME"] = sys.argv[2]
environment["XDG_STATE_HOME"] = sys.argv[3]
daemon = None
try:
    with open(sys.argv[4], "w", encoding="utf-8") as output:
        daemon = subprocess.Popen(
            [sys.argv[1], "daemon", "start", "--interval", "300"],
            env=environment,
            stdout=output,
        )
        lock = os.path.join(sys.argv[3], "maniud", "daemon.lock")
        deadline = time.monotonic() + 10
        while True:
            try:
                ready = os.path.getsize(lock) > 0
            except FileNotFoundError:
                ready = False
            if ready:
                break
            if daemon.poll() is not None:
                raise SystemExit(f"daemon start exited before acquiring its lock: {daemon.returncode}")
            if time.monotonic() >= deadline:
                raise SystemExit("daemon start did not acquire its lock")
            time.sleep(0.01)
        stopped = subprocess.run(
            [sys.argv[1], "daemon", "stop"],
            env=environment,
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
        status = daemon.wait(timeout=10)
finally:
    if daemon is not None and daemon.poll() is None:
        daemon.terminate()
        try:
            daemon.wait(timeout=5)
        except subprocess.TimeoutExpired:
            daemon.kill()
            daemon.wait()
if stopped.returncode != 0 or stopped.stdout != "Daemon stopped.\n":
    raise SystemExit(f"daemon stop returned {stopped.returncode}, {stopped.stdout!r}, {stopped.stderr!r}")
if status != 0:
    raise SystemExit(f"daemon start returned {status}, want 0")
PY

doctor_output="$temporary_dir/doctor.json"
env "${shared_environment[@]}" "$binary" doctor --reindex-backups >"$doctor_output"
python3 - "$doctor_output" false <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    result = json.load(stream)
expected_replaced = sys.argv[2] == "true"
if result.get("entries") != [] or result.get("replaced") is not expected_replaced:
    raise SystemExit(f"unexpected doctor result: {result!r}")
if not result.get("root", "").endswith("/maniud/backups"):
    raise SystemExit(f"unexpected backup root: {result!r}")
PY

env "${shared_environment[@]}" "$binary" doctor --reindex-backups --confirm >"$doctor_output"
python3 - "$doctor_output" true <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    result = json.load(stream)
expected_replaced = sys.argv[2] == "true"
if result.get("entries") != [] or result.get("replaced") is not expected_replaced:
    raise SystemExit(f"unexpected doctor result: {result!r}")
if not result.get("root", "").endswith("/maniud/backups"):
    raise SystemExit(f"unexpected backup root: {result!r}")
PY

printf '%s\n' 'five-command executable smoke passed'
