#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)); then
	printf 'usage: %s command [argument ...]\n' "$0" >&2
	exit 2
fi

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
mapfile -t module_names < <("$repository_root/scripts/list-go-modules")

for module_name in "${module_names[@]}"; do
	printf '==> %s: %s\n' "$module_name" "$*"
	(cd "$repository_root/$module_name" && env GOWORK=off "$@")
done
