#!/usr/bin/env bash
set -euo pipefail

packages_file=""
profile_argument=""
while (($# > 0)); do
	case "$1" in
	--packages-from)
		if (($# < 2)) || [[ -z "$2" ]]; then
			printf '%s\n' '--packages-from requires a package-list file' >&2
			exit 2
		fi
		packages_file="$(realpath "$2")"
		shift 2
		;;
	-*)
		printf 'unknown option: %s\n' "$1" >&2
		exit 2
		;;
	*)
		if [[ -n "$profile_argument" ]]; then
			printf 'usage: %s [--packages-from file] [cover-profile]\n' "$0" >&2
			exit 2
		fi
		profile_argument="$1"
		shift
		;;
	esac
done

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
temporary_dir="$(mktemp -d)"
trap 'rm -rf "$temporary_dir"' EXIT
profile="${profile_argument:-$temporary_dir/statements.cover}"
if [[ "$profile" != /* ]]; then
	profile="$PWD/$profile"
fi
test_cgo=0
if [[ "${MANIUD_CI_RACE:-0}" == 1 ]]; then
	test_cgo=1
fi

module_names=()
while IFS= read -r module_name; do
	module_names+=("$module_name")
done < <("$repository_root/scripts/list-go-modules")
module_profiles=()
for module_number in "${!module_names[@]}"; do
	module_name="${module_names[$module_number]}"
	module_directory="$(cd "$repository_root/$module_name" && pwd -P)"
	coverage_patterns=(./...)
	if [[ "$module_name" == "." ]]; then
		coverage_patterns=(./internal/... ./plugins/...)
	fi
	coverage_packages=()
	if [[ -n "$packages_file" ]]; then
		while IFS= read -r coverage_package; do
			coverage_packages+=("$coverage_package")
		done < <(awk -F $'\t' -v module="$module_name" '$1 == module { print $2 }' "$packages_file")
	else
		while IFS= read -r coverage_package; do
			coverage_packages+=("$coverage_package")
		done < <(
			cd "$module_directory"
			GOWORK=off CGO_ENABLED="$test_cgo" go list "${coverage_patterns[@]}"
		)
	fi
	if ((${#coverage_packages[@]} == 0)); then
		continue
	fi
	coverpkg="$(IFS=,; printf '%s' "${coverage_packages[*]}")"
	module_profile="$temporary_dir/statements-$module_number.cover"
	module_profiles+=("$module_profile")
	test_args=(
		-count=1
		-covermode=atomic
		-coverpkg="$coverpkg"
		-coverprofile="$module_profile"
	)
	if [[ "${MANIUD_CI_RACE:-0}" == 1 ]]; then
		test_args=(-race "${test_args[@]}")
	fi
	(
		cd "$module_directory"
		GOWORK=off CGO_ENABLED="$test_cgo" go test "${test_args[@]}" "${coverage_packages[@]}"
	)
	module_path="$(cd "$module_directory" && GOWORK=off go list -m -f '{{.Path}}')"
	absolute_module_profile="$temporary_dir/absolute-$module_number.cover"
	awk -v module_prefix="$module_path/" -v directory="$module_directory/" '
    NR == 1 { print; next }
    index($1, module_prefix) == 1 {
      $1 = directory substr($1, length(module_prefix) + 1)
    }
    { print }
  ' "$module_profile" >"$absolute_module_profile"
	mv "$absolute_module_profile" "$module_profile"
done

if ((${#module_profiles[@]} == 0)); then
	printf '%s\n' 'no packages selected for coverage' >&2
	exit 1
fi

absolute_profile="$temporary_dir/statements-absolute.cover"
{
	printf '%s\n' 'mode: atomic'
	awk '
    FNR == 1 { next }
    {
      statements[$1] = $2
      hits[$1] += $3
    }
    END {
      for (block in statements) print block, statements[block], hits[block]
    }
  ' "${module_profiles[@]}" | sort
} >"$absolute_profile"

repository_module_path="$(cd "$repository_root" && GOWORK=off go list -m -f '{{.Path}}')"
cover_report="$(GOWORK=off go tool cover -func="$absolute_profile")"
printf '%s\n' "${cover_report//"$repository_root/"/"$repository_module_path/"}"
awk -v directory="$repository_root/" -v module_prefix="$repository_module_path/" '
  NR == 1 { print; next }
  index($1, directory) == 1 {
    $1 = module_prefix substr($1, length(directory) + 1)
  }
  { print }
' "$absolute_profile" >"$profile"

read -r covered_statements total_statements < <(
	awk '
    NR > 1 {
      statements[$1] = $2
      if ($3 > 0) hit[$1] = 1
    }
    END {
      for (block in statements) {
        total += statements[block]
        if (hit[block]) covered += statements[block]
      }
      print covered, total
    }
  ' "$profile"
)
if ((covered_statements != total_statements)); then
	printf 'covered statements are %d/%d, want %d/%d\n' \
		"$covered_statements" "$total_statements" "$total_statements" "$total_statements" >&2
	exit 1
fi

if ! command -v gobco >/dev/null 2>&1; then
	printf '%s\n' 'gobco is missing; rerun .agents/setup.' >&2
	exit 1
fi

# Gobco v1.3.4 resolves ignored platform files before filtering build tags.
# Use a disposable current-platform source tree so type checking sees exactly
# the files selected by the Go toolchain. The original worktree stays untouched.
source_copy="$temporary_dir/source"
mkdir -p "$source_copy"
(cd "$repository_root" && tar --exclude=.git --exclude=.amp -cf - .) | tar -xf - -C "$source_copy"
# Branch coverage runs tests from the disposable source copy. Give tests that
# verify source provenance a local revision without copying repository history.
git -C "$source_copy" init --quiet
git -C "$source_copy" \
	-c user.name=maniud-coverage \
	-c user.email=coverage@localhost \
	commit --quiet --allow-empty --no-gpg-sign -m coverage-source
(
	cd "$source_copy"

	: >"$temporary_dir/packages.tsv"
	: >"$temporary_dir/coverage-directories.txt"
	for module_name in "${module_names[@]}"; do
		module_directory="$(cd "$source_copy/$module_name" && pwd -P)"
		python3 - "$module_directory/go.mod" "$module_directory" <<'PY'
from pathlib import Path
import re
import sys

module_file = Path(sys.argv[1])
module_directory = Path(sys.argv[2])
contents = module_file.read_text(encoding="utf-8")
contents = re.sub(
    r"(=>[ \t]+)(\.\.?(?:/[^\s]+)?)",
    lambda match: match.group(1) + str((module_directory / match.group(2)).resolve()),
    contents,
)
module_file.write_text(contents, encoding="utf-8")
PY
		coverage_patterns=(./...)
		if [[ "$module_name" == "." ]]; then
			coverage_patterns=(./internal/... ./plugins/...)
		fi
		coverage_packages=()
		if [[ -n "$packages_file" ]]; then
			while IFS= read -r coverage_package; do
				coverage_packages+=("$coverage_package")
			done < <(awk -F $'\t' -v module="$module_name" '$1 == module { print $2 }' "$packages_file")
		else
			coverage_packages=("${coverage_patterns[@]}")
		fi
		if ((${#coverage_packages[@]} == 0)); then
			continue
		fi
		(
			cd "$module_directory"
			GOWORK=off CGO_ENABLED="$test_cgo" go list -f \
				'{{.Dir}}{{"\t"}}{{join .GoFiles "\t"}}{{"\t"}}{{join .CgoFiles "\t"}}{{"\t"}}{{join .TestGoFiles "\t"}}{{"\t"}}{{join .XTestGoFiles "\t"}}' \
				"${coverage_packages[@]}"
		) >>"$temporary_dir/packages.tsv"
		while IFS= read -r coverage_directory; do
			printf '%s\t%s\n' "$module_directory" "$coverage_directory" \
				>>"$temporary_dir/coverage-directories.txt"
		done < <(
			cd "$module_directory"
			GOWORK=off CGO_ENABLED="$test_cgo" go list -f '{{.Dir}}' "${coverage_packages[@]}"
		)
	done
	while IFS=$'\t' read -r package_dir selected_files; do
		selected_files=$'\t'"$selected_files"$'\t'
		shopt -s nullglob
		for source_file in "$package_dir"/*.go; do
			filename="$(basename "$source_file")"
			if [[ "$selected_files" != *$'\t'"$filename"$'\t'* ]]; then
				rm -f "$source_file"
			fi
		done
		shopt -u nullglob
	done <"$temporary_dir/packages.tsv"

	covered_branches=0
	total_branches=0
	package_number=0
	while IFS=$'\t' read -r module_directory package_dir; do
		stats="$temporary_dir/branches-$package_number.json"
		log="$temporary_dir/branches-$package_number.log"
		if ! (
			cd "$module_directory"
			MANIUD_BRANCH_COVERAGE=1 GOWORK=off CGO_ENABLED="$test_cgo" \
				gobco -branch -stats "$stats" "$package_dir"
		) >"$log" 2>&1; then
			cat "$log" >&2
			exit 1
		fi
		cat "$log"

		read -r package_covered package_total < <(
			python3 - "$stats" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    branches = json.load(stream)

missing = []
covered = 0
for branch in branches:
    true_count = branch["TrueCount"]
    false_count = branch["FalseCount"]
    covered += int(true_count > 0) + int(false_count > 0)
    if true_count == 0 or false_count == 0:
        missing.append(branch)

if missing:
    for branch in missing:
        print(
            f'uncovered branch at {branch["Start"]}: {branch["Code"]} '
            f'(true={branch["TrueCount"]}, false={branch["FalseCount"]})',
            file=sys.stderr,
        )
    raise SystemExit(1)

print(covered, len(branches) * 2)
PY
		)
		covered_branches=$((covered_branches + package_covered))
		total_branches=$((total_branches + package_total))
		package_number=$((package_number + 1))
	done <"$temporary_dir/coverage-directories.txt"

	printf 'covered branch outcomes are %d/%d\n' "$covered_branches" "$total_branches"
)
