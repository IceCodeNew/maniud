#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
current_goos="$(go env GOOS)"
current_goarch="$(go env GOARCH)"
if [[ "$current_goos" != darwin || "$current_goarch" != arm64 ]]; then
	printf 'platform coverage must run natively on darwin/arm64; current runner is %s/%s\n' \
		"$current_goos" "$current_goarch" >&2
	exit 1
fi

temporary_dir="$(mktemp -d)"
trap 'rm -rf "$temporary_dir"' EXIT
darwin_manifests="$temporary_dir/darwin-arm64-packages.tsv"
linux_manifests="$temporary_dir/linux-amd64-packages.tsv"
selected_packages="$temporary_dir/platform-packages.tsv"
manifest_template='{{.ImportPath}}{{"\t"}}{{.Dir}}{{"\t"}}{{join .GoFiles ","}}{{"\t"}}{{join .CgoFiles ","}}{{"\t"}}{{join .TestGoFiles ","}}{{"\t"}}{{join .XTestGoFiles ","}}'

while IFS= read -r module_name; do
	module_directory="$(cd "$repository_root/$module_name" && pwd -P)"
	coverage_patterns=(./...)
	if [[ "$module_name" == "." ]]; then
		coverage_patterns=(./internal/...)
	fi
	(
		cd "$module_directory"
		GOWORK=off CGO_ENABLED=0 go list -f "$manifest_template" "${coverage_patterns[@]}"
	) | awk -v module="$module_name" '{ print module "\t" $0 }' >>"$darwin_manifests"
	(
		cd "$module_directory"
		GOWORK=off GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
			go list -f "$manifest_template" "${coverage_patterns[@]}"
	) | awk -v module="$module_name" '{ print module "\t" $0 }' >>"$linux_manifests"
done < <("$repository_root/scripts/list-go-modules")

python3 - "$linux_manifests" "$darwin_manifests" >"$selected_packages" <<'PY'
import csv
from pathlib import Path
import sys


def read_manifests(filename):
    with open(filename, encoding="utf-8", newline="") as stream:
        return list(csv.reader(stream, delimiter="\t"))


def reads_platform(package_directory, selected_filenames):
    for filenames in selected_filenames:
        for filename in filenames.split(","):
            if not filename:
                continue
            contents = (Path(package_directory) / filename).read_text(encoding="utf-8")
            if "runtime.GOOS" in contents or "runtime.GOARCH" in contents:
                return True
    return False


linux_packages = {
    (row[0], row[1]): row[3:]
    for row in read_manifests(sys.argv[1])
}
for row in read_manifests(sys.argv[2]):
    selected_files = row[3:]
    if reads_platform(row[2], selected_files) or linux_packages.get((row[0], row[1])) != selected_files:
        print(row[0], row[1], sep="\t")
PY

if [[ ! -s "$selected_packages" ]]; then
	printf '%s\n' 'no darwin/arm64 platform-dependent packages found' >&2
	exit 1
fi

printf '%s\n' 'darwin/arm64 platform-dependent packages:'
cut -f2 "$selected_packages" | sed 's/^/  /'
MANIUD_CI_RACE=1 "$repository_root/scripts/check-go-coverage" \
	--packages-from "$selected_packages" "$@"
