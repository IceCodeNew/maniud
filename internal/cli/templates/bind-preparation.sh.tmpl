#!/bin/sh
set -eu

# Generated by maniud. Review every path, owner, and mode before running.
# Run this script on the container runtime host before maniud apply.
# Each entry creates a missing directory by default; change directory to file when needed.

uid={{.UID}}
gid={{.GID}}

prepare_bind() {
  missing_kind=$1
  path=$2
  if [ -L "$path" ]; then
    printf 'maniud: refusing symbolic-link bind source: %s\n' "$path" >&2
    exit 1
  fi
  if [ ! -e "$path" ]; then
    case "$missing_kind" in
      directory) mkdir -p "$path" ;;
      file) mkdir -p "$(dirname "$path")" && : > "$path" ;;
      *) printf 'maniud: invalid missing bind source kind: %s\n' "$missing_kind" >&2; exit 1 ;;
    esac
  fi
  if [ -d "$path" ]; then
    chmod 0750 "$path"
  elif [ -f "$path" ]; then
    chmod 0640 "$path"
  else
    printf 'maniud: bind source is not a regular file or directory: %s\n' "$path" >&2
    exit 1
  fi
  chown "$uid:$gid" "$path"
}

{{range .Paths}}prepare_bind directory {{shellQuote .}}
{{end}}
