#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
cd "$repo_root"

# shellcheck source=.agents/tool-versions.sh
source "$repo_root/.agents/tool-versions.sh"

readonly GIT_USER_NAME='IceCodeNew'
readonly GIT_USER_EMAIL='32576256+IceCodeNew@users.noreply.github.com'
readonly CONTAINERD_CONFIG_PATH='/etc/maniud/containerd.toml'
readonly CONTAINERD_ADDRESS='/run/maniud-containerd/containerd.sock'
readonly DOCKER_GROUP='docker'
readonly NERDCTL_CONFIG_PATH='/etc/nerdctl/nerdctl.toml'
# Release assets may move independently of their checksum file. Pin the
# maintainer key fingerprint while Renovate updates the release version.
readonly NERDCTL_SIGNER_FINGERPRINT='C020EA876CE4E06C7AB95AEF49524C6F9F638F1A'

run_step() {
  local label="$1"
  shift
  printf '==> %s\n' "$label"
  time "$@"
}

package_is_installed() {
  [[ "$(dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null)" == 'ii '* ]]
}

disable_system_runtime_services() {
  local unit
  local unit_state

  sudo systemctl mask --now docker.service docker.socket containerd.service >/dev/null
  for unit in docker.service docker.socket containerd.service; do
    unit_state="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
    if [[ "$unit_state" != 'masked' ]]; then
      printf '%s is not masked.\n' "$unit" >&2
      return 1
    fi
    if systemctl is-active --quiet "$unit"; then
      printf '%s is still active.\n' "$unit" >&2
      return 1
    fi
  done
}

stop_supervised_runtimes() {
  local service
  local running_services

  running_services="$(amp orb service list)"
  for service in docker nerdctl-containerd; do
    if grep -Fq "amp-svc-$service.service" <<<"$running_services"; then
      amp orb service stop "$service"
    fi
  done
}

configure_git() (
  local signing_dir="${XDG_CONFIG_HOME:-$HOME/.config}/maniud/git"
  local signing_key="$signing_dir/commit-signing-key"
  local allowed_signers="$signing_dir/allowed-signers"
  local temporary_key
  local temporary_allowed_signers

  install -m 0700 -d "$signing_dir"
  if [[ -z "${GIT_SSH_KEY:-}" ]]; then
    printf '%s\n' 'GIT_SSH_KEY must contain the base64-encoded Git signing key.' >&2
    return 1
  fi

  umask 077
  temporary_key="$(mktemp "$signing_dir/.commit-signing-key.XXXXXX")"
  temporary_allowed_signers="$(mktemp "$signing_dir/.allowed-signers.XXXXXX")"
  trap 'rm -f "$temporary_key" "$temporary_allowed_signers"' EXIT
  printf '%s' "$GIT_SSH_KEY" | base64 --decode >"$temporary_key" 2>/dev/null
  ssh-keygen -y -f "$temporary_key" >/dev/null 2>&1
  printf '%s %s\n' "$GIT_USER_EMAIL" "$(ssh-keygen -y -f "$temporary_key")" >"$temporary_allowed_signers"
  install -m 0600 "$temporary_key" "$signing_key"
  install -m 0600 "$temporary_allowed_signers" "$allowed_signers"
  git config --global user.name "$GIT_USER_NAME"
  git config --global user.email "$GIT_USER_EMAIL"
  git config --global user.signingkey "$signing_key"
  git config --global commit.gpgsign true
  git config --global gpg.format ssh
  git config --global gpg.ssh.program ssh-keygen
  git config --global gpg.ssh.allowedSignersFile "$allowed_signers"
)

configure_amp_commit_privacy() {
  local settings_dir="${XDG_CONFIG_HOME:-$HOME/.config}/amp"
  local settings_path="$settings_dir/settings.json"

  mkdir -p "$settings_dir"
  SETTINGS_PATH="$settings_path" python3 - <<'PY'
import json
import os
from pathlib import Path

path = Path(os.environ["SETTINGS_PATH"])
settings = json.loads(path.read_text()) if path.exists() else {}
settings["amp.git.commit.ampThread.enabled"] = False
settings["amp.git.commit.coauthor.enabled"] = False
temporary = path.with_suffix(".tmp")
temporary.write_text(json.dumps(settings, indent=2, sort_keys=True) + "\n")
temporary.chmod(0o600)
temporary.replace(path)
PY
}

install_system_packages() {
  if command -v curl >/dev/null 2>&1 \
    && command -v gpg >/dev/null 2>&1 \
    && command -v newgidmap >/dev/null 2>&1 \
    && command -v newuidmap >/dev/null 2>&1 \
    && command -v podman >/dev/null 2>&1 \
    && command -v ssh-keygen >/dev/null 2>&1 \
    && command -v unzip >/dev/null 2>&1 \
    && package_is_installed podman; then
    return
  fi

  sudo apt-get update
  sudo apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    openssh-client \
    podman \
    python3-minimal \
    uidmap \
    unzip
}

install_docker_tools() {
  disable_system_runtime_services
  if package_is_installed docker-ce \
    && package_is_installed docker-ce-cli \
    && package_is_installed containerd.io \
    && package_is_installed docker-compose-plugin \
    && docker compose version >/dev/null 2>&1; then
    return
  fi

  sudo install -m 0755 -d /etc/apt/keyrings
  if [[ ! -f /etc/apt/keyrings/docker.asc ]]; then
    sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc
  fi
  if [[ ! -f /etc/apt/sources.list.d/docker.list ]]; then
    local architecture codename
    architecture="$(dpkg --print-architecture)"
    codename="$(sed -n 's/^VERSION_CODENAME=//p' /etc/os-release | tr -d '"')"
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian %s stable\n' \
      "$architecture" "$codename" | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
  fi

  sudo apt-get update
  sudo apt-get install -y --no-install-recommends \
    containerd.io \
    docker-ce \
    docker-ce-cli \
    docker-compose-plugin
  disable_system_runtime_services
}

install_nerdctl_tools() (
  local archive
  local archive_name
  local checksum_file
  local expected_checksum
  local gnupg_home
  local public_key_file
  local required_path
  local signature_file
  local temporary_dir
  local valid_signer
  local verification_status

  if [[ "$(/usr/local/bin/nerdctl --version 2>/dev/null | awk '{print $3}')" == "$NERDCTL_VERSION" ]] \
    && [[ -x /usr/local/bin/buildctl ]] \
    && [[ -x /usr/local/bin/buildkitd ]] \
    && [[ -x /usr/local/bin/containerd ]] \
    && [[ -x /usr/local/bin/containerd-shim-runc-v2 ]] \
    && [[ -x /usr/local/bin/runc ]] \
    && [[ -x /usr/local/libexec/cni/bridge ]]; then
    return
  fi

  temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/maniud-nerdctl.XXXXXX")"
  trap 'rm -rf "$temporary_dir"' EXIT
  archive_name="nerdctl-full-$NERDCTL_VERSION-linux-amd64.tar.gz"
  archive="$temporary_dir/$archive_name"
  checksum_file="$temporary_dir/SHA256SUMS"
  signature_file="$temporary_dir/SHA256SUMS.asc"
  public_key_file="$temporary_dir/release-manager.gpg"
  gnupg_home="$temporary_dir/gnupg"
  install -m 0700 -d "$gnupg_home"
  curl --fail --location --retry 3 \
    --output "$archive" \
    "https://github.com/containerd/nerdctl/releases/download/v$NERDCTL_VERSION/$archive_name"
  curl --fail --location --retry 3 \
    --output "$checksum_file" \
    "https://github.com/containerd/nerdctl/releases/download/v$NERDCTL_VERSION/SHA256SUMS"
  curl --fail --location --retry 3 \
    --output "$signature_file" \
    "https://github.com/containerd/nerdctl/releases/download/v$NERDCTL_VERSION/SHA256SUMS.asc"
  curl --fail --location --retry 3 \
    --output "$public_key_file" \
    'https://github.com/AkihiroSuda.gpg'
  GNUPGHOME="$gnupg_home" gpg --batch --quiet --import "$public_key_file"
  if ! verification_status="$(
    GNUPGHOME="$gnupg_home" gpg \
      --batch \
      --status-fd=1 \
      --verify "$signature_file" "$checksum_file" 2>/dev/null
  )"; then
    printf '%s\n' 'The nerdctl checksum signature is invalid.' >&2
    return 1
  fi
  valid_signer="$(
    awk '
      $1 == "[GNUPG:]" && $2 == "VALIDSIG" {
        if (found) exit 2
        print $3
        found = 1
      }
      END { if (!found) exit 1 }
    ' <<<"$verification_status"
  )"
  if [[ "$valid_signer" != "$NERDCTL_SIGNER_FINGERPRINT" ]]; then
    printf 'The nerdctl checksum signer %s is not the reviewed release manager.\n' "$valid_signer" >&2
    return 1
  fi
  expected_checksum="$(awk -v name="$archive_name" '$2 == name { print $1 }' "$checksum_file")"
  if [[ ! "$expected_checksum" =~ ^[[:xdigit:]]{64}$ ]]; then
    printf 'The nerdctl checksum manifest has no unique entry for %s.\n' "$archive_name" >&2
    return 1
  fi
  printf '%s  %s\n' "$expected_checksum" "$archive" | sha256sum --check --strict
  sudo tar Cxzvvf /usr/local "$archive"
  for required_path in \
    /usr/local/bin/buildctl \
    /usr/local/bin/buildkitd \
    /usr/local/bin/containerd \
    /usr/local/bin/containerd-shim-runc-v2 \
    /usr/local/bin/nerdctl \
    /usr/local/bin/runc \
    /usr/local/libexec/cni/bridge; do
    if [[ ! -x "$required_path" ]]; then
      printf 'The nerdctl full bundle is missing %s.\n' "$required_path" >&2
      return 1
    fi
  done
)

configure_runtime_access() {
  sudo groupadd --force "$DOCKER_GROUP"
  sudo usermod --append --groups "$DOCKER_GROUP" "$(id -un)"
}

configure_containerd() (
  local temporary_config
  local temporary_nerdctl_config
  local docker_group_id

  docker_group_id="$(getent group "$DOCKER_GROUP" | cut -d: -f3)"
  temporary_config="$(mktemp "${TMPDIR:-/tmp}/maniud-containerd.XXXXXX")"
  temporary_nerdctl_config="$(mktemp "${TMPDIR:-/tmp}/maniud-nerdctl.XXXXXX")"
  trap 'rm -f "$temporary_config" "$temporary_nerdctl_config"' EXIT
  cat >"$temporary_config" <<EOF
version = 4
root = '/var/lib/maniud-containerd'
state = '/run/maniud-containerd'

[plugins.'io.containerd.server.v1.grpc']
  address = '$CONTAINERD_ADDRESS'
  uid = 0
  gid = $docker_group_id

[plugins.'io.containerd.server.v1.ttrpc']
  address = '$CONTAINERD_ADDRESS.ttrpc'
  uid = 0
  gid = $docker_group_id
EOF
  cat >"$temporary_nerdctl_config" <<EOF
address = 'unix://$CONTAINERD_ADDRESS'
cni_path = '/usr/local/libexec/cni'
cni_netconfpath = '/usr/local/etc/cni/net.d'
EOF
  sudo install -m 0755 -d /etc/maniud /etc/nerdctl /var/lib/maniud-containerd
  sudo install -m 0644 "$temporary_config" "$CONTAINERD_CONFIG_PATH"
  sudo install -m 0644 "$temporary_nerdctl_config" "$NERDCTL_CONFIG_PATH"
)

install_mise() {
  if ! command -v mise >/dev/null 2>&1; then
    curl https://mise.run/bash | sh
  fi
  export PATH="$HOME/.local/bin:$PATH"
}

configure_mise_login_shell() {
  local profile="$HOME/.bash_profile"

  touch "$profile"
  PROFILE="$profile" python3 - <<'PY'
import os
from pathlib import Path

path = Path(os.environ["PROFILE"])
marker = "# maniud mise activation"
old_block = """# maniud mise activation
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi
"""
correct_block = """# maniud mise activation
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
  eval "$("$HOME/.local/bin/mise" hook-env -s bash)"
fi
"""
content = path.read_text()
marker_count = sum(line == marker for line in content.splitlines())

if marker_count == 0:
    separator = "" if not content else "\n" if content.endswith("\n") else "\n\n"
    path.write_text(content + separator + correct_block)
elif marker_count == 1 and correct_block in content:
    pass
elif marker_count == 1 and old_block in content:
    content = content.replace(old_block, "", 1)
    separator = "" if not content else "\n" if content.endswith("\n") else "\n\n"
    path.write_text(content + separator + correct_block)
else:
    raise SystemExit(f"Refusing to replace unrecognized or duplicate {marker!r} blocks")
PY
}

install_golang() {
  if [[ -n "$GO_VERSION" ]]; then
    mise use --global "go@$GO_VERSION"
  else
    mise use --global go
  fi
  eval "$(mise hook-env -s bash)"
  # Keep developer builds CGO-free by default. The race gate opts back in explicitly.
  go env -w CGO_ENABLED=0 GOPROXY='https://golang.flatt.tech'
}

install_mise_tools() {
  local binary
  local command_name
  local compiler
  local tool_backend
  local tool_version

  mise use --global uv
  mise use --global \
    ast-grep bun node@lts prek shellcheck shfmt \
    "golangci-lint@$GOLANGCI_LINT_VERSION" \
    "go:github.com/google/capslock/cmd/capslock@$CAPSLOCK_VERSION" \
    "go:github.com/rillig/gobco@$GOBCO_VERSION" \
    "go:go.uber.org/nilaway/cmd/nilaway@$NILAWAY_VERSION" \
    "go:github.com/tailscale/depaware@$DEPAWARE_VERSION" \
    "go:github.com/uber-go/gopatch" \
    "go:golang.org/x/vuln/cmd/govulncheck@$GOVULNCHECK_VERSION" \
    "npm:greptile" \
    "npm:openskills" \
    "pipx:nmem-cli"

  while read -r command_name tool_backend; do
    binary="$(mise which "$command_name")"
    compiler="$(go version -m "$binary" | awk 'NR == 1 { print $NF }')"
    if [[ "$compiler" != "$(go env GOVERSION)" ]]; then
      tool_version="$(mise current "$tool_backend")"
      mise uninstall "$tool_backend@$tool_version"
      mise install "$tool_backend@$tool_version"
    fi
  done <<'GO_TOOLS'
capslock go:github.com/google/capslock/cmd/capslock
gobco go:github.com/rillig/gobco
nilaway go:go.uber.org/nilaway/cmd/nilaway
depaware go:github.com/tailscale/depaware
gopatch go:github.com/uber-go/gopatch
govulncheck go:golang.org/x/vuln/cmd/govulncheck
GO_TOOLS
  mise reshim
}

install_coderabbit_cli() {
  # The official installer selects the current stable binary for this platform.
  # Authentication remains an explicit user action and is never persisted by setup.
  curl -fsSL https://cli.coderabbit.ai/install.sh | env CI=1 sh
}

update_managed_checkout() {
  local destination="$1"
  local expected_origin="$2"
  local actual_origin

  actual_origin="$(git -C "$destination" remote get-url origin 2>/dev/null || true)"
  if [[ "$actual_origin" != "$expected_origin" ]]; then
    printf 'Refusing to update managed checkout with an unexpected origin: %s\n' "$destination" >&2
    return 1
  fi
  if ! git -C "$destination" symbolic-ref --quiet HEAD >/dev/null \
    || [[ -n "$(git -C "$destination" status --porcelain)" ]]; then
    printf 'Refusing to update a detached or modified managed checkout: %s\n' "$destination" >&2
    return 1
  fi

  git -C "$destination" fetch --quiet --depth 1 origin HEAD
  git -C "$destination" reset --hard --quiet FETCH_HEAD
}

install_ninehills_skills() (
  eval "$(mise hook-env -s bash)"
  local source_dir="$HOME/.cache/maniud/ninehills-skills"
  local source_url='https://github.com/ninehills/skills.git'

  if [[ -e "$source_dir" && ! -d "$source_dir/.git" ]]; then
    printf 'Refusing to replace unmanaged ninehills source directory: %s\n' "$source_dir" >&2
    return 1
  fi
  if [[ ! -d "$source_dir/.git" ]]; then
    git clone --quiet --depth 1 "$source_url" "$source_dir"
  else
    update_managed_checkout "$source_dir" "$source_url"
  fi
  amp skill add --global --overwrite "$source_dir"
)

install_gstack() (
  eval "$(mise hook-env -s bash)"
  local destination="$HOME/.agents/skills/gstack"
  local compatibility_dir="$HOME/.agent/skills"
  local compatibility_path="$compatibility_dir/gstack"
  local state_dir="$HOME/.cache/maniud"
  local setup_marker="$state_dir/gstack-setup-revision"
  local setup_log="$HOME/.cache/amp/logs/maniud-gstack-setup.log"
  local source_url='https://github.com/garrytan/gstack.git'
  local revision
  local setup_required=false

  if [[ -e "$destination" && ! -d "$destination/.git" ]]; then
    printf 'Refusing to replace unmanaged gstack directory: %s\n' "$destination" >&2
    return 1
  fi
  if [[ ! -d "$destination/.git" ]]; then
    git clone --quiet --depth 1 "$source_url" "$destination"
    setup_required=true
  else
    update_managed_checkout "$destination" "$source_url"
  fi

  if [[ ! -d "$destination/node_modules" ]]; then
    bun install --cwd "$destination"
    setup_required=true
  fi

  mkdir -p "$compatibility_dir" "$state_dir" "$(dirname "$setup_log")"
  if [[ -L "$compatibility_path" ]]; then
    if [[ "$(readlink -f "$compatibility_path")" != "$destination" ]]; then
      printf 'Refusing to replace unrelated gstack skill link: %s\n' "$compatibility_path" >&2
      return 1
    fi
  elif [[ -e "$compatibility_path" ]]; then
    printf 'Refusing to replace unmanaged gstack skill path: %s\n' "$compatibility_path" >&2
    return 1
  else
    ln -s "$destination" "$compatibility_path"
  fi

  revision="$(git -C "$destination" rev-parse HEAD)"
  if [[ ! -f "$setup_marker" ]] || ! grep -Fqx "$revision" "$setup_marker"; then
    setup_required=true
  fi
  if [[ "$setup_required" == true ]]; then
    if ! "$destination/setup" --host claude --no-team --no-prefix -q >"$setup_log" 2>&1; then
      cat "$setup_log" >&2
      return 1
    fi
    printf '%s\n' "$revision" >"$setup_marker"
  fi

  openskills read gstack >/dev/null
)

verify_nmem_environment() {
  command -v nmem >/dev/null 2>&1 || {
    printf '%s\n' 'nmem is missing; rerun .agents/setup.' >&2
    return 1
  }
  if [[ -z "${NMEM_API_URL:-}" || -z "${NMEM_API_KEY:-}" ]]; then
    printf '%s\n' 'NMEM_API_URL and NMEM_API_KEY must be set for Nowledge Mem.' >&2
    return 1
  fi
}

configure_nmem() {
  eval "$(mise hook-env -s bash)"
  nmem config client set --url "$NMEM_API_URL" --api-key "$NMEM_API_KEY" >/dev/null
  nmem --json status >/dev/null
}

run_step 'Install required system packages and Podman' install_system_packages
run_step 'Install mise' install_mise
run_step 'Configure mise for login shells' configure_mise_login_shell
run_step 'Install golang' install_golang
run_step 'Install mise-managed tools' install_mise_tools
run_step 'Install the latest CodeRabbit CLI' install_coderabbit_cli
run_step 'Configure signed Git commits' configure_git
run_step 'Disable commit identity trailers' configure_amp_commit_privacy
run_step 'Stop supervised container runtimes before updating them' stop_supervised_runtimes
run_step 'Install Docker tools' install_docker_tools
run_step "Install nerdctl $NERDCTL_VERSION full bundle" install_nerdctl_tools
run_step 'Grant the orb user access to container runtime sockets' configure_runtime_access
run_step 'Configure the supervised containerd daemon' configure_containerd
run_step 'Install latest ninehills skills' install_ninehills_skills
run_step 'Install and load gstack' install_gstack
run_step 'Verify Nowledge Mem environment' verify_nmem_environment
run_step 'Configure and verify Nowledge Mem' configure_nmem
run_step 'Start and verify supervised container runtimes' "$repo_root/.agents/resume"

printf '%s\n' 'Orb setup complete.'
