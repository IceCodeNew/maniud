# Uncomment the settings you use and pass them in maniud's process environment.
# Bark and Telegram do not load .env automatically.
# For docker run --env-file, save a copy as .env and keep values unquoted.

# Change HOME once to move all maniud data.
# HOME=/home/maniud

# Bark and Telegram can be enabled together. Keep real credentials out of Git.
# BARK_DEVICE_KEY=replace-with-device-key
# To encrypt Bark messages, set the same key in the Bark app.
# The key must be 16, 24, or 32 ASCII characters.
# BARK_ENCRYPTION_KEY=replace-with-encryption-key

# Telegram requires both values.
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id

# LLM deployment assistance is configured from maniud tui.
# Only LLM settings also load from the current .env and the XDG .env.
# Process environment takes precedence; TUI saves update the protected XDG file.
# Supported providers: openai, openai-compatible, deepseek.
# MANIUD_LLM_PROVIDER=openai
# MANIUD_LLM_MODEL=replace-with-model
# MANIUD_LLM_TIMEOUT=60
# OPENAI_BASE_URL=https://provider.example/v1
# OPENAI_API_KEY=replace-with-api-key
# DEEPSEEK_API_KEY=replace-with-api-key
